# This script executes gridSetup.sh -configtools

# Idempotent: yes

# Variables

grid_home="{{ grid_ora_home }}"
config_log="{{ logs_dir }}/config.log"

# Main

if [ -f {{ done_dir }}/rootupgrade.done ]; then
	if [ ! -f {{ done_dir }}/configtools.done ]; then	
		export SKIP_ROOTPRE="TRUE" && $grid_home/gridSetup.sh -silent -executeConfigTools -responseFile {{ files_dir }}/oracle19c_grid_install.rsp > $config_log 2>&1
	fi
else
	echo "ERROR: rootupgrade.sh didn't complete successfully, not proceeding further. Exiting"
exit 1	
fi

if grep -q "Successfully Configured Software" $config_log; then
	touch "{{ done_dir }}/configtools.done"
	echo "gridSetup.sh -executeConfigTools completed successfully"
else
	echo "ERROR: gridSetup.sh -executeConfigTools failed. See $config_log for details."
exit 1
fi
exit 0
