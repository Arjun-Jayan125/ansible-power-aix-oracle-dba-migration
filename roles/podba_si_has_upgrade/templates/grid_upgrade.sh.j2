# This script executes rootupgrade.sh

# Idempotent: yes

# Variables

grid_ora_home="{{ grid_ora_home }}"
rootupgrd_log="{{ logs_dir }}/rootupgrd.out"

# Main

if [ ! -f {{ done_dir }}/rootupgrade.done ]; then
    export LDR_CNTRL=MAXDATA=0x80000000
    $grid_ora_home/rootupgrade.sh > $rootupgrd_log 2>&1

    outlog=$(awk '{print $2}' $rootupgrd_log)
    if grep -q "Successfully configured Oracle Restart for a standalone server" $outlog; then
        echo "Rootupgrade.sh completed successfully"
        touch {{ done_dir }}/rootupgrade.done
    else
        echo "Rootupgrade.sh didn't complete successfully. Review the log $outlog on the host lpar"
        exit 1
    fi
fi
exit 0
